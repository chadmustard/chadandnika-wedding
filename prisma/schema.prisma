generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Room block options at the hotel.
enum RoomType {
  QUEENS_GARDEN
  QUEENS_OCEAN
  KING_GARDEN
  KING_OCEAN
}

model Household {
  id      String @id @default(cuid())
  label   String
  address String

  // Room block (entered by the couple in the admin panel)
  roomType  RoomType?
  /// Check-in / check-out nights at the hotel.
  checkIn   DateTime? @db.Date
  checkOut  DateTime? @db.Date
  roomNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  people    Person[]
  gifts     Gift[]
}

/// A gift received (Venmo honeymoon fund, physical gifts, etc.), logged by
/// the couple so they can track thank-you notes.
model Gift {
  id             String     @id @default(cuid())
  householdId    String?
  household      Household? @relation(fields: [householdId], references: [id], onDelete: SetNull)
  /// Who it's from, as it should read on the thank-you note.
  fromName       String
  event          String? // wedding | engagement
  description    String
  amountCents    Int?
  receivedOn     DateTime?  @db.Date
  thankYouSentOn DateTime?  @db.Date
  notes          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([householdId])
}

model Person {
  id              String     @id @default(cuid())
  displayName     String
  profileImageUrl String
  inviteToken     String     @unique @default(cuid())
  isCouple        Boolean    @default(false)
  sortOrder       Int        @default(0)
  /// E.164 (e.g. +15135550123). Guests unlock the site by entering it.
  phone           String?
  householdId     String?
  household       Household? @relation(fields: [householdId], references: [id], onDelete: SetNull)

  // Travel (entered by the couple in the admin panel). Times are wall-clock
  // at the destination, stored as if UTC; display with timeZone 'UTC'.
  arrivalAt       DateTime?
  arrivalFlight   String?
  departureAt     DateTime?
  departureFlight String?
  /// Airport they fly out of to get to us (e.g. CVG).
  homeAirport     String?

  // Optional visit tracking
  firstVisitAt DateTime?
  lastVisitAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stays          LocationStay[]
  uploadedPhotos LocationPhoto[] @relation("UploadedBy")
  invitations    Invitation[]

  @@index([householdId])
  @@index([phone])
}

/// One row per person per event they're invited to. Event details live in
/// `src/lib/events.ts`; `event` is that file's slug.
model Invitation {
  id       String @id @default(cuid())
  personId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  event    String // wedding | engagement

  attending           Boolean?
  dietaryRestrictions String?
  respondedAt         DateTime?
  /// First time the guest watched their envelope open.
  openedAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([personId, event])
  @@index([event])
}

/// Fixed-window rate limit counters (shared across serverless instances).
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime
}

model LocationStay {
  id         String          @id @default(cuid())
  personId   String
  person     Person          @relation(fields: [personId], references: [id], onDelete: Cascade)
  placeLabel String
  region     String // us | ukraine | italy | singapore
  lat        Float
  lng        Float
  isCurrent  Boolean         @default(false)
  sortOrder  Int
  photos     LocationPhoto[]

  @@index([personId])
}

model LocationPhoto {
  id                 String       @id @default(cuid())
  locationStayId     String
  locationStay       LocationStay @relation(fields: [locationStayId], references: [id], onDelete: Cascade)
  uploadedByPersonId String?
  uploadedBy         Person?      @relation("UploadedBy", fields: [uploadedByPersonId], references: [id])
  imageUrl           String
  caption            String?
  createdAt          DateTime     @default(now())
}
